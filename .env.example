# ─────────────────────────────────────────────────────────────
#  Vercel → Settings → Environment Variables 에 넣는 값들입니다.
#  모두 선택 사항이며, 없으면 코드에 있는 기본값이 쓰입니다.
#  이 파일은 예시일 뿐이라 실제 값을 적지 마세요.
# ─────────────────────────────────────────────────────────────

# 실제 도메인 연결 후 지정 (SEO / 카카오톡 공유 썸네일 주소에 사용)
# 지정하지 않으면 Vercel 배포 주소가 자동으로 사용됩니다.
NEXT_PUBLIC_SITE_URL=https://example.co.kr

# 네이버 서치어드바이저 사이트 소유확인 코드
NEXT_PUBLIC_NAVER_VERIFICATION=

# 구글 서치콘솔 사이트 소유확인 코드
NEXT_PUBLIC_GOOGLE_VERIFICATION=
